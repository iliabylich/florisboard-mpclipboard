From 1ba6e8587ed7ed20aae86f22bcf87cafd1928048 Mon Sep 17 00:00:00 2001
From: MPClipboard developer <dev@mpclipboard>
Date: Tue, 1 Sep 2026 00:00:00 +0000
Subject: [PATCH] send to/receive from MPClipboard

---
 app/build.gradle.kts                                       | 7 ++++---
 app/src/main/AndroidManifest.xml                           | 3 +++
 .../aidl/dev/ibylich/mpclipboard/IMPClipboardCallback.aidl | 1 +
 .../aidl/dev/ibylich/mpclipboard/IMPClipboardService.aidl  | 1 +
 .../dev/patrickgold/florisboard/FlorisApplication.kt       | 1 +
 .../dev/patrickgold/florisboard/MPClipboardClient.kt       | 1 +
 gradle/libs.versions.toml                                  | 2 +-
 7 files changed, 12 insertions(+), 4 deletions(-)
 create mode 120000 app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardCallback.aidl
 create mode 120000 app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardService.aidl
 create mode 120000 app/src/main/kotlin/dev/patrickgold/florisboard/MPClipboardClient.kt

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 34c4cbd4..37959f5d 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -67,7 +67,7 @@ android {
     }
 
     defaultConfig {
-        applicationId = "dev.patrickgold.florisboard"
+        applicationId = "dev.ibylich.florisboard"
         minSdk = projectMinSdk.toInt()
         targetSdk = projectTargetSdk.toInt()
         versionCode = projectVersionCode.toInt()
@@ -101,6 +101,7 @@ android {
     }
 
     buildFeatures {
+        aidl = true
         buildConfig = true
         compose = true
     }
@@ -116,7 +117,7 @@ android {
             resValue("mipmap", "floris_app_icon", "@mipmap/ic_app_icon_debug")
             resValue("mipmap", "floris_app_icon_round", "@mipmap/ic_app_icon_debug_round")
             resValue("drawable", "floris_app_icon_foreground", "@drawable/ic_app_icon_debug_foreground")
-            resValue("string", "floris_app_name", "FlorisBoard Debug")
+            resValue("string", "floris_app_name", "FlorisBoard Debug + MPClipboard")
         }
 
         create("beta") {
@@ -143,7 +144,7 @@ android {
             resValue("mipmap", "floris_app_icon", "@mipmap/ic_app_icon_stable")
             resValue("mipmap", "floris_app_icon_round", "@mipmap/ic_app_icon_stable_round")
             resValue("drawable", "floris_app_icon_foreground", "@drawable/ic_app_icon_stable_foreground")
-            resValue("string", "floris_app_name", "@string/app_name")
+            resValue("string", "floris_app_name", "FlorisBoard + MPClipboard")
         }
 
         create("benchmark") {
diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index cfeb7b64..226fb8d3 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -8,11 +8,14 @@
     <!-- Permission needed to create notifications on devices running Android 13+ -->
     <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 
+    <uses-permission android:name="dev.ibylich.mpclipboard.permission.BIND_SERVICE"/>
+
     <!-- Android 11+ only: Define that FlorisBoard requests to see all apps that
           ship with an IME or Spell Check service. This is used to guide the user
           in the Settings Ui why FlorisBoard may not be working.
      -->
     <queries>
+        <package android:name="dev.ibylich.mpclipboard"/>
         <intent>
             <action android:name="android.view.InputMethod"/>
         </intent>
diff --git a/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardCallback.aidl b/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardCallback.aidl
new file mode 120000
index 00000000..36441646
--- /dev/null
+++ b/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardCallback.aidl
@@ -0,0 +1 @@
+../../../../../../../../src/IMPClipboardCallback.aidl
\ No newline at end of file
diff --git a/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardService.aidl b/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardService.aidl
new file mode 120000
index 00000000..bee45df8
--- /dev/null
+++ b/app/src/main/aidl/dev/ibylich/mpclipboard/IMPClipboardService.aidl
@@ -0,0 +1 @@
+../../../../../../../../src/IMPClipboardService.aidl
\ No newline at end of file
diff --git a/app/src/main/kotlin/dev/patrickgold/florisboard/FlorisApplication.kt b/app/src/main/kotlin/dev/patrickgold/florisboard/FlorisApplication.kt
index 31a5cc4f..51c4fd43 100644
--- a/app/src/main/kotlin/dev/patrickgold/florisboard/FlorisApplication.kt
+++ b/app/src/main/kotlin/dev/patrickgold/florisboard/FlorisApplication.kt
@@ -124,6 +124,7 @@ class FlorisApplication : Application() {
         }
         extensionManager.value.init()
         clipboardManager.value.initializeForContext(this)
+        MPClipboardClient(this).start()
         DictionaryManager.init(this)
     }
 
diff --git a/app/src/main/kotlin/dev/patrickgold/florisboard/MPClipboardClient.kt b/app/src/main/kotlin/dev/patrickgold/florisboard/MPClipboardClient.kt
new file mode 120000
index 00000000..b6da5336
--- /dev/null
+++ b/app/src/main/kotlin/dev/patrickgold/florisboard/MPClipboardClient.kt
@@ -0,0 +1 @@
+../../../../../../../../src/MPClipboardClient.kt
\ No newline at end of file
diff --git a/gradle/libs.versions.toml b/gradle/libs.versions.toml
index 71225aea..226b6e24 100644
--- a/gradle/libs.versions.toml
+++ b/gradle/libs.versions.toml
@@ -21,7 +21,7 @@ ksp = "2.2.20-2.0.3"
 material-kolor = "4.0.5"
 mikepenz-aboutlibraries = "13.1.0"
 patrickgold-compose-tooltip = "0.2.0-rc02"
-patrickgold-jetpref = "20251119T222500Z-SNAPSHOT"
+patrickgold-jetpref = "0.3.0"
 
 # Testing
 androidx-benchmark = "1.3.4"
